@model List<CMS.Data.Entities.OrderDetail>

<h2>CHI TIẾT ĐƠN HÀNG</h2>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Mã đơn</th>
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>

                <td>
                    @item.OrderId
                </td>

                <td>
                    @item.Product?.Name
                </td>

                <td>
                    @item.Quantity
                </td>

                <td>
                    @item.UnitPrice.ToString("N0") VNĐ
                </td>
            </tr>
        }
    </tbody>
</table>