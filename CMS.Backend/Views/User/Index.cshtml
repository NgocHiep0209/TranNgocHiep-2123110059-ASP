@model List<CMS.Data.Entities.User>

@{
    Layout = "_LayoutAdmin";
}

    <div class="card shadow-sm border-0">
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="text-dark">QUẢN LÝ THÀNH VIÊN</h2>
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Thêm thành viên mới
            </a>
        </div>

    </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light text-dark fw-bold" style="background-color: #f8f9fa; border-bottom: 2px solid #dee2e6;">
                    <tr>
                        <th style="width: 8%; padding: 12px 16px;">ID</th>
                        <th style="width: 25%;">Tên Đăng Nhập</th>
                        <th style="width: 25%;">Họ Và Tên</th>
                        <th style="width: 22%;">Quyền Hạn</th>
                        <th class="text-center" style="width: 20%;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr style="border-bottom: 1px solid #eee;">
                            <td class="fw-semibold text-secondary" style="padding: 14px 16px;">@user.Id</td>
                            <td class="fw-bold text-dark">@user.Username</td>
                            <td class="text-secondary">@user.FullName</td>
                            <td>
                                @if (user.Role?.ToLower() == "administrator" || user.Role == "Admin")
                                {
                                    <span class="badge px-2 py-1.5 fw-semibold" style="background-color: #dc3545; color: white; border-radius: 6px; font-size: 0.85rem;">Administrator</span>
                                }
                                else if (user.Role?.ToLower() == "editor")
                                {
                                    <span class="badge px-2 py-1.5 fw-semibold" style="background-color: #00b0ff; color: white; border-radius: 6px; font-size: 0.85rem;">Editor</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-2 py-1.5" style="border-radius: 6px; font-size: 0.85rem;">@user.Role</span>
                                }
                            </td>
                            <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-warning">
                                Sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên @user.Username không?')">
                                Xóa
                            </a>


                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>