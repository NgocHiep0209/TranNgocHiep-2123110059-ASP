@model List<CMS.Data.Entities.Product>
@{
    Layout = "_LayoutAdmin";
}
<h2>DANH SÁCH SẢN PHẨM</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tên SP</th>
            <th>Giá</th>
            <th>Tồn kho</th>
            <th>Danh mục</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>@item.StockQuantity</td>
                <td>@item.CategoryProduct?.Name</td>
            </tr>
        }
    </tbody>
</table>